{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hark",
  "version": "0.2.0",
  "identifier": "com.hy.cloris.hark",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hark",
        "width": 1250,
        "height": 740,
        "minWidth": 1100,
        "minHeight": 680,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/bin", "resources/CHANGELOG.md", "resources/changelog/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
